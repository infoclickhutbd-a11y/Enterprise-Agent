{%- comment -%}
  Petal and Pounce: Trust / USP bar
  A row of short trust points (icon + text, optional link), e.g. delivery,
  returns, UK based. Works in templates and in the header group.

  Google Merchant Center note: every point must be true and match the
  Shipping / Refund policy and GMC settings (thresholds, return window).
{%- endcomment -%}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }
  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<style>
  .pp-trust-bar__list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.2rem 1.6rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .pp-trust-bar--scroll .pp-trust-bar__list {
    display: flex;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
  }
  .pp-trust-bar--scroll .pp-trust-bar__list::-webkit-scrollbar {
    display: none;
  }
  .pp-trust-bar--scroll .pp-trust-bar__item {
    flex: 0 0 auto;
    scroll-snap-align: start;
  }
  @media screen and (min-width: 750px) {
    .pp-trust-bar__list,
    .pp-trust-bar--scroll .pp-trust-bar__list {
      display: flex;
      flex-wrap: wrap;
      justify-content: space-around;
      overflow: visible;
    }
  }
  .pp-trust-bar__item {
    display: flex;
    align-items: center;
    gap: 0.8rem;
    font-size: 1.3rem;
    line-height: 1.3;
  }
  .pp-trust-bar__item .svg-wrapper {
    flex-shrink: 0;
    width: 2.2rem;
    height: 2.2rem;
  }
  .pp-trust-bar__item .svg-wrapper svg {
    width: 100%;
    height: 100%;
  }
  .pp-trust-bar__item a {
    color: inherit;
    text-decoration: none;
  }
  .pp-trust-bar__item a:hover,
  .pp-trust-bar__item a:focus-visible {
    text-decoration: underline;
    text-underline-offset: 0.3rem;
  }
  .pp-trust-bar__text p {
    margin: 0;
  }
</style>

<div class="pp-trust-bar color-{{ section.settings.color_scheme }} gradient{% if section.settings.mobile_layout == 'scroll' %} pp-trust-bar--scroll{% endif %}">
  <div class="page-width section-{{ section.id }}-padding">
    {%- if section.settings.heading != blank -%}
      <h2 class="visually-hidden">{{ section.settings.heading | escape }}</h2>
    {%- endif -%}
    <ul class="pp-trust-bar__list" role="list">
      {%- for block in section.blocks -%}
        <li class="pp-trust-bar__item" {{ block.shopify_attributes }}>
          {%- if block.settings.link != blank -%}<a href="{{ block.settings.link }}" class="pp-trust-bar__item">{%- endif -%}
          {%- render 'icon-accordion', icon: block.settings.icon -%}
          <span class="pp-trust-bar__text">{{ block.settings.text }}</span>
          {%- if block.settings.link != blank -%}</a>{%- endif -%}
        </li>
      {%- endfor -%}
    </ul>
  </div>
</div>

{% schema %}
{
  "name": "Trust bar",
  "tag": "section",
  "class": "section",
  "max_blocks": 6,
  "settings": [
    {
      "type": "paragraph",
      "content": "Only list promises you actually keep. Delivery thresholds and return windows must match your Shipping and Refund policies and Google Merchant Center settings."
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading for screen readers",
      "default": "Why shop with us"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "background-2"
    },
    {
      "type": "select",
      "id": "mobile_layout",
      "label": "Mobile layout",
      "options": [
        { "value": "grid", "label": "2-column grid" },
        { "value": "scroll", "label": "Swipeable row" }
      ],
      "default": "grid"
    },
    {
      "type": "header",
      "content": "Section padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 60,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 12
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 60,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 12
    }
  ],
  "blocks": [
    {
      "type": "point",
      "name": "Trust point",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "none", "label": "None" },
            { "value": "truck", "label": "Delivery truck" },
            { "value": "return", "label": "Returns" },
            { "value": "map_pin", "label": "Location pin" },
            { "value": "paw_print", "label": "Paw print" },
            { "value": "plant", "label": "Plant" },
            { "value": "leaf", "label": "Leaf" },
            { "value": "heart", "label": "Heart" },
            { "value": "padlock", "label": "Padlock" },
            { "value": "chat_bubble", "label": "Chat bubble" },
            { "value": "star", "label": "Star" },
            { "value": "box", "label": "Box" },
            { "value": "stopwatch", "label": "Stopwatch" },
            { "value": "check_mark", "label": "Check mark" }
          ],
          "default": "check_mark"
        },
        {
          "type": "inline_richtext",
          "id": "text",
          "label": "Text",
          "default": "Edit this trust point"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link (e.g. Shipping policy)"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Trust bar",
      "blocks": [
        { "type": "point", "settings": { "icon": "truck", "text": "Free UK delivery over £[AMOUNT]" } },
        { "type": "point", "settings": { "icon": "return", "text": "[NUMBER]-day returns" } },
        { "type": "point", "settings": { "icon": "map_pin", "text": "Packed in [TOWN], UK" } },
        { "type": "point", "settings": { "icon": "padlock", "text": "Secure checkout" } }
      ]
    }
  ]
}
{% endschema %}
