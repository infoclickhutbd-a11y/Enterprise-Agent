{%- comment -%}
  Petal and Pounce: Icon cards (e.g. "How ordering works": Browse, Packed with care, Delivery)
{%- endcomment -%}
{{ 'pp-sections.css' | asset_url | stylesheet_tag }}

<div class="color-{{ section.settings.color_scheme }} gradient">
  <div
    class="page-width pp-section"
    style="--pp-pt: {{ section.settings.padding_top }}px; --pp-pb: {{ section.settings.padding_bottom }}px;"
  >
    {%- render 'pp-section-intro',
      eyebrow: section.settings.eyebrow,
      heading: section.settings.heading,
      text: section.settings.text
    -%}
    <ul class="pp-cards" role="list" style="--pp-cols: {{ section.blocks.size | at_most: 4 | at_least: 1 }};">
      {%- for block in section.blocks -%}
        <li class="pp-card color-{{ section.settings.card_color_scheme }}" {{ block.shopify_attributes }}>
          {%- render 'icon-accordion', icon: block.settings.icon -%}
          {%- if block.settings.title != blank -%}
            <h3 class="pp-card__title h4">{{ block.settings.title | escape }}</h3>
          {%- endif -%}
          {%- if block.settings.text != blank -%}
            <div class="pp-card__text rte">{{ block.settings.text }}</div>
          {%- endif -%}
        </li>
      {%- endfor -%}
    </ul>
  </div>
</div>

{% schema %}
{
  "name": "Icon cards",
  "tag": "section",
  "class": "section",
  "max_blocks": 4,
  "disabled_on": { "groups": ["header", "footer"] },
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Small text above heading" },
    { "type": "inline_richtext", "id": "heading", "label": "Heading", "default": "How it works" },
    { "type": "richtext", "id": "text", "label": "Text" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Section color scheme", "default": "accent-2" },
    { "type": "color_scheme", "id": "card_color_scheme", "label": "Card color scheme", "default": "background-1" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Top padding", "default": 56 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Bottom padding", "default": 56 }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Card",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "none", "label": "None" },
            { "value": "cart", "label": "Cart" },
            { "value": "box", "label": "Box" },
            { "value": "truck", "label": "Delivery truck" },
            { "value": "return", "label": "Returns" },
            { "value": "plant", "label": "Plant" },
            { "value": "leaf", "label": "Leaf" },
            { "value": "paw_print", "label": "Paw print" },
            { "value": "heart", "label": "Heart" },
            { "value": "map_pin", "label": "Location pin" },
            { "value": "chat_bubble", "label": "Chat bubble" },
            { "value": "stopwatch", "label": "Stopwatch" },
            { "value": "padlock", "label": "Padlock" },
            { "value": "recycle", "label": "Recycle" }
          ],
          "default": "box"
        },
        { "type": "text", "id": "title", "label": "Title", "default": "Card title" },
        { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Describe this step in one or two sentences.</p>" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Icon cards",
      "blocks": [
        { "type": "card", "settings": { "icon": "cart", "title": "Browse and order" } },
        { "type": "card", "settings": { "icon": "box", "title": "Packed with care" } },
        { "type": "card", "settings": { "icon": "truck", "title": "Delivered to your door" } }
      ]
    }
  ]
}
{% endschema %}
