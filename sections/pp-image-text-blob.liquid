{%- comment -%}
  Petal and Pounce: Image with text (organic shape)
  Use for the homepage hero (heading as H1), "Welcome" and "Our story" blocks.
  Only one H1 per page: set "Heading level" to H1 on the hero only.
{%- endcomment -%}
{{ 'pp-sections.css' | asset_url | stylesheet_tag }}

<div class="color-{{ section.settings.color_scheme }} gradient">
  <div
    class="page-width pp-section"
    style="--pp-pt: {{ section.settings.padding_top }}px; --pp-pb: {{ section.settings.padding_bottom }}px;"
  >
    <div class="pp-blob pp-blob--image-{{ section.settings.image_position }}">
      <div class="pp-blob__content">
        {%- render 'pp-section-intro',
          eyebrow: section.settings.eyebrow,
          heading: section.settings.heading,
          heading_tag: section.settings.heading_tag,
          text: section.settings.text,
          align: 'left'
        -%}
        {%- if section.settings.button_label != blank or section.settings.button_label_2 != blank -%}
          <div class="pp-buttons">
            {%- if section.settings.button_label != blank -%}
              <a
                {% if section.settings.button_link != blank %}
                  href="{{ section.settings.button_link }}"
                {% else %}
                  role="link" aria-disabled="true"
                {% endif %}
                class="button button--primary"
              >
                {{- section.settings.button_label | escape -}}
              </a>
            {%- endif -%}
            {%- if section.settings.button_label_2 != blank -%}
              <a
                {% if section.settings.button_link_2 != blank %}
                  href="{{ section.settings.button_link_2 }}"
                {% else %}
                  role="link" aria-disabled="true"
                {% endif %}
                class="button button--secondary"
              >
                {{- section.settings.button_label_2 | escape -}}
              </a>
            {%- endif -%}
          </div>
        {%- endif -%}
      </div>

      <div class="pp-blob__media pp-blob__media--{{ section.settings.image_shape }}">
        {%- if section.settings.image != blank -%}
          {%- liquid
            if section.settings.heading_tag == 'h1'
              assign loading = 'eager'
              assign priority = 'high'
            else
              assign loading = 'lazy'
              assign priority = 'auto'
            endif
          -%}
          {{
            section.settings.image
            | image_url: width: 1200
            | image_tag:
              loading: loading,
              fetchpriority: priority,
              widths: '375, 550, 750, 1000, 1200',
              sizes: '(min-width: 750px) 50vw, 100vw'
          }}
        {%- else -%}
          {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}
        {%- endif -%}
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Image with text (shape)",
  "tag": "section",
  "class": "section",
  "disabled_on": { "groups": ["header", "footer"] },
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Image" },
    {
      "type": "select",
      "id": "image_shape",
      "label": "Image shape",
      "options": [
        { "value": "blob", "label": "Organic blob" },
        { "value": "circle", "label": "Circle" },
        { "value": "rounded", "label": "Rounded square" }
      ],
      "default": "blob"
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "Image position on desktop",
      "options": [
        { "value": "right", "label": "Right" },
        { "value": "left", "label": "Left" }
      ],
      "default": "right"
    },
    { "type": "text", "id": "eyebrow", "label": "Small text above heading" },
    { "type": "inline_richtext", "id": "heading", "label": "Heading", "default": "Image with text" },
    {
      "type": "select",
      "id": "heading_tag",
      "label": "Heading level",
      "info": "Use H1 only on the first section of the homepage.",
      "options": [
        { "value": "h1", "label": "H1 (page title)" },
        { "value": "h2", "label": "H2" }
      ],
      "default": "h2"
    },
    { "type": "richtext", "id": "text", "label": "Text" },
    { "type": "header", "content": "Buttons" },
    { "type": "text", "id": "button_label", "label": "First button label" },
    { "type": "url", "id": "button_link", "label": "First button link" },
    { "type": "text", "id": "button_label_2", "label": "Second button label" },
    { "type": "url", "id": "button_link_2", "label": "Second button link" },
    { "type": "header", "content": "Style" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "accent-1" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Top padding", "default": 56 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Bottom padding", "default": 56 }
  ],
  "presets": [
    {
      "name": "Image with text (shape)",
      "settings": {
        "eyebrow": "Our story",
        "heading": "Tell customers who you are",
        "text": "<p>Share what you sell, who is behind the shop and why you started.</p>",
        "button_label": "Read our story"
      }
    }
  ]
}
{% endschema %}
